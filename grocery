        }
    }

    private int searchItem(String target) {
        String[] data = groceryList.toArray(new String[0]);

        int linearResult = linearSerch(data, target);

        String[] sortedData = Arrays.copyOf(data, data.length);
        Arrays.sort(sortedData);
        int binaryResult = binarySerch(sortedData, target);

        boolean hashResult = hashmap.containsKey(target);

        if(binaryResult == -1 || !hashResult) {
            return -1;
        }
        return linearResult;
    }

    public static int linearSearch(String[] data, String target) {
        for(int i = 0; i < data.length; i++) {
            if(data[i].equals(target)) {
                return i;
            }
        }
        return -1;
    }

    public static int binarySearch(String[] data, String target) {
        int left = 0, right = data.length - 1;

        while(left <= right) {
            int mid = left + (right - left) / 2;
            int compare = data[mid].compareTo(target);

            if(compare == 0) {
                return mid;
            }
            else if(compare < 0) {
                left = mid + 1;
            }
            else {
                right = mid - 1;
            }
        }
        return -1;
    }

