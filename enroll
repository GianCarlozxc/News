            return;
        }

        int index = serachStudent(name);

        if(e.getSource() == enroll || e.getSource() == txt) {

            if(index != -1) {
                JOptionPane.showMessageDialog(this, "\"" + name + "\" is already enrolled.");
            }
            else {
                studentList.add(name);
                hashmap.add(name, "false");

                txt.setText("");

                JOptionPane.showMessageDialog(this, "\"" + name + "\" has been enrolled.")
            }
        }

        else if(e.getSource() == withdraw) {

            if(index = -1) {
                JOptionPane.showMessageDialog(this, "\"" + name + "\" is not enrolled.");
            }
            else {
                studentList.delete(index);
                hashmap.remove(name);

                txt.setText("");

                JOptionPane.showMessageDialog(this, "\"" + name + "\" has been withdrawn.");
            }
        }

        else if(e.getSource() == done) {

