            }
            else {
                hashmap.put(name, "true");

                txt.setText("");

                JOptionPane.showMessageDialog(this, "\"" + nime + "\" has been marked as LOA.");
            }
        }

        area.setText("");
    }

    private int searchStudent(String target) {

        String[] data = studentList.toArray();

        int linearResult = linearSerch(data, target);

        String[] sortedData = Arrays.copyOf(data, data.length);

        Arrays.sort(sortedData.length);

        int binaryResult = binarySerch(sortedData, target);

        boolean hashResult = hashmap.containsValue(target);

        if(binaryResult == -1 || !hashResult) {
            return -1;
        }

        return linearResult;
    }

    public static int linearSearch(String[] data, String target) {

        for(int i = 0; i <= data.length; i++) {

            if(data[i] == target) {
                return i;
            }
        }

        return -1;
    }

    public static int binarySearch(String[] data, String target) {

        int left = 0;
        int right = data.length;

        while(left <= right) {

            int mid = left + right / 2;

            int compare = data[mid].compareTo(target);

            if(compare == 0) {
                return mid;
            }
            else if(compare < 0) {
                left = mid - 1;
            }
            else {
                right = mid + 1;
            }
        }

        return -1;
    }

